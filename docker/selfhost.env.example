# Settings for docker-compose.yml itself; the app's own settings go in .env
# (copy .env.example). Copy this file to selfhost.env and pass it with
#   docker compose --env-file selfhost.env up -d --build
# so the database admin password never reaches the app container.

# --- SQL Server ---
# The sa password: 8+ characters with three of upper case, lower case, digits
# and symbols, or SQL Server refuses to start.
SQL_SA_PASSWORD=
# Express is free for production (10 GB per database). Developer is free for
# non-production use only.
MSSQL_PID=Express
SQL_DATABASE=lms

# --- The app's own SQL login (data access to the lms schema, no DDL) ---
LMS_APP_SQL_USER=lms_app
# Same complexity rule as SQL_SA_PASSWORD.
LMS_APP_SQL_PASSWORD=

# --- First tenant (created once; leave LMS_BOOTSTRAP_SLUG empty to skip) ---
# Set LMS_APEX_TENANT_SLUG in .env to this slug to serve it at the apex host.
LMS_BOOTSTRAP_SLUG=
LMS_BOOTSTRAP_NAME=
# Users sign in with Microsoft Entra: give the directory (tenant) id their
# accounts live in, or a verified email domain, or both.
LMS_BOOTSTRAP_AAD_TENANT_ID=
LMS_BOOTSTRAP_DOMAIN=
LMS_BOOTSTRAP_ADMIN_EMAIL=
LMS_BOOTSTRAP_HOSTNAME=

# --- Build ---
# Until the app drops ForIT's private packages it needs a forit-Common checkout
# and, in the environment (not this file), NODE_AUTH_TOKEN: a GitHub token that
# can read the @foritllc package registry.
FORIT_COMMON_DIR=../forit-Common

# --- Host ---
LMS_PORT=3000

