{
  "name": "forit-lms",
  "version": "0.1.0",
  "private": true,
  "description": "ForIT LMS — white-label multi-tenant learning platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed:starter": "tsx scripts/seed-starter-courses.ts",
    "validate:courses": "tsx scripts/validate-courses.ts",
    "test": "node --import tsx --test \"lib/**/*.test.ts\"",
    "predev": "npm run build:auth",
    "prebuild": "npm run build:auth",
    "pretypecheck": "npm run build:auth",
    "pretest": "npm run build:auth",
    "build:auth": "tsc --project vendor/foritllc-auth/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@foritllc/auth": "file:vendor/foritllc-auth",
    "@tailwindcss/typography": "^0.5.19",
    "dotenv": "^17.4.2",
    "jsonrepair": "^3.14.0",
    "mssql": "^10.0.0",
    "next": "^15.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tedious": "^16.7.1",
    "ts-fsrs": "5.4.2",
    "youtube-transcript": "^1.3.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.22.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ForITLLC/lms-core.git"
  },
  "author": "ForIT LLC",
  "license": "AGPL-3.0-only"
}
