# Every setting the app reads, grouped by feature. Only the first two groups are
# needed to run it; each later group switches one feature on.

# --- Sign-in (@foritllc/auth: signed session cookie + Microsoft Entra OAuth) ---
# A multi-tenant Entra app registration ('organizations' authority). Which LMS
# tenant a user lands in is decided after sign-in by their Entra tid
# (lib/auth/tenant-binding.ts), so any directory may sign in.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=organizations
# 32+ random bytes as hex: `openssl rand -hex 32`. Must be the same on every
# instance, or sessions break on each restart.
SESSION_SECRET=
# Empty keeps the session cookie on the host the user signed in on. Set a
# parent domain (e.g. .learn.example.org) to share one sign-in across tenant
# subdomains under it.
LMS_COOKIE_DOMAIN=
# The audience the iPhone/iPad app's ID tokens are checked against
# (lib/mobile/id-token.ts). Only needed for the native app.
FORIT_SIGNIN_CLIENT_ID=

# --- Database (SQL Server / Azure SQL, tables in the lms schema) ---
# Server and database are both required: with either unset the app refuses to
# connect rather than guess.
SQL_SERVER=
# Optional; unset uses 1433.
SQL_PORT=
SQL_DATABASE=
# password (default) uses SQL_USER/SQL_PASSWORD; managed-identity uses the App
# Service identity, or SQL_MANAGED_IDENTITY_CLIENT_ID for a user-assigned one.
SQL_AUTH=password
SQL_USER=
SQL_PASSWORD=
SQL_MANAGED_IDENTITY_CLIENT_ID=
# Optional: where service-run and error records go (logging.usp_RecordServiceRun
# and usp_RecordError), signing in the same way as above. Both unset keeps them
# in SQL_DATABASE; set both or neither. LOGGING_SQL_PORT unset uses 1433.
LOGGING_SQL_SERVER=
LOGGING_SQL_DATABASE=
LOGGING_SQL_PORT=

# --- Tenant hosting ---
# Tenants are served at <slug>.<LMS_APEX_DOMAIN> or their own CustomHostname.
LMS_APEX_DOMAIN=learn.example.org
# The tenant the apex host itself shows.
LMS_APEX_TENANT_SLUG=forit
# Tenant and sign-in host come from Host. Set true only behind a proxy that
# rewrites Host and overwrites X-Forwarded-Host with the browser's host.
LMS_TRUST_FORWARDED_HOST=false

# --- AI authoring and tutor (lib/ai/claude.ts) ---
ANTHROPIC_API_KEY=
# Tenant slugs (comma-separated) whose authors may draft courses with AI; empty turns it off for every tenant.
AI_AUTHORING_TENANTS=

# --- Training records (lib/records/switch.ts) ---
# Tenant ids or slugs (comma-separated) that get training records; empty turns them off for every tenant.
TRAINING_RECORDS_TENANTS=

# --- Microsoft Graph and Azure management, outside App Service ---
# In App Service the managed identity is used (IDENTITY_ENDPOINT/IDENTITY_HEADER
# are set by the platform). Locally, a client-credentials app instead:
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# --- Tenant DNS provisioning (POST /api/admin/tenants/[slug]/provision-dns) ---
# A Cloudflare API token scoped to DNS Edit on the apex zone. Never the
# account's global API key.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# true: Cloudflare terminates TLS and the Azure certificate step is skipped.
CLOUDFLARE_PROXIED=true
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_APP_NAME=
AZURE_APP_PLAN=
AZURE_LOCATION=

# --- Scheduled jobs (/api/cron/*) ---
# Callers send `Authorization: Bearer ${CRON_SECRET}`: `openssl rand -hex 32`.
CRON_SECRET=
# Tenant the learners sync runs for when the request names none.
FORIT_TENANT_SLUG=forit

# --- Learning summary and feedback mail ---
# Sender when the tenant's branding sets none (TenantBranding.EmailSenderAddress).
LMS_DIGEST_FROM=
# One-click unsubscribe links are signed with EMAIL_UNSUBSCRIBE_KEY_<ID>; the
# current key's <ID> goes in EMAIL_UNSUBSCRIBE_CURRENT_KEY. Keep old keys set
# until links signed with them have expired. Each key: `openssl rand -hex 32`.
# Leave both unset to run without the summary mail; naming a current key with
# no value set for it is refused.
# EMAIL_UNSUBSCRIBE_KEY_K1=
# EMAIL_UNSUBSCRIBE_CURRENT_KEY=k1
# Hashes addresses in the opt-out store, so it never holds an address in clear.
EMAIL_ADDRESS_PEPPER=

# --- Training marketplace (/api/v1/marketplace/*) ---
# The marketplace's Entra app (client) id. Unset, every marketplace call is
# refused.
MARKETPLACE_CALLER_APP_ID=

# --- Build metadata (CI sets both) ---
# Reported by /api/health at run time.
BUILD_SHA=
# Baked into the build by next.config.mjs and reported by /api/version.
GIT_SHA=
